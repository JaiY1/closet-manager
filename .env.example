ANTHROPIC_API_KEY=your_key_here
SERPER_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
# Where all mutable data lives (DB, vectors, images, caches). Defaults to the
# project root. In production point this at a mounted persistent volume, e.g. /data
# DATA_DIR=/data
SECRET_KEY=generate_with_python_-c_"import secrets; print(secrets.token_hex(32))"

# --- Auth ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Register redirect URI: <your-app-url>/auth/google/callback
# Unset = the "Sign in with Google" button is hidden, no crash.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# resend.com API key, for the forgot-password email. Unset = reset links are
# logged instead of emailed (fine for local dev only).
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Closet <onboarding@resend.dev>
